  m_Script: {fileID: 11500000, guid: eb984b9659922422289d138524dd1324, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SkillTimeControl
  skillName: TimeControl
  skillType: 0
  description: Creates a domain that slows down enemies and enemy projectiles within
    its area.
  upgrades:
  - upgradeName: Temporal Corrosion
    description: Enemies within the field take continuous damage over time
    unlocked: 0
  - upgradeName: Vulnerable Field
    description: Enemies within the field gain vulnerable effect.
    unlocked: 0
  - upgradeName: Synchronized Field
    description: "The field follows the player\u2019s movement"
    unlocked: 0
  - upgradeName: Hunting Time
    description: Killing enemies during the skill extends its duration
    unlocked: 0
  betterUpgrades:
  - upgradeName: Temporal Corrosion+
    description: Enemies take a burst of damage when entering the field, but no longer
      take continuous damage afterward.
    unlocked: 0
  - upgradeName: Vulnerable Field+
    description: Enemies inside the field have their armor reduced to zero and gain
      vulnerable effect.
    unlocked: 0
  - upgradeName: Synchronized Field+
    description: "The field follows the player\u2019s movement, after the domain
      is moved, its effect will still persist in the original location for a short
      period of time."
    unlocked: 0
  - upgradeName: Hunting Time+
    description: Killing enemies during the skill extends its duration and releases
      a small time shockwave from the dead enemy, damaging nearby enemies.
    unlocked: 0
  - upgradeName: Stasis Field
    description: Enemies inside the field stop moving and acting.
    unlocked: 0
  skillPhaseUpgrades:
  - upgradeName: 2 Upgrades
    description: Increase 20% of skill effect
    unlocked: 0
  - upgradeName: 4 Upgrades
    description: Using 2 times of skill will only increase 1 skill decay
    unlocked: 0
  - upgradeName: 6 Upgrades
    description: All major attribute (except skill effect) increase 10%
    unlocked: 0
  - upgradeName: Full Upgrades
    description: All major attribute (except skill effect) increase 20%
    unlocked: 0
  decreaseRate: []
  decreaseIndex: 0
  playerSkillManager: {fileID: 6596648338181236841}
  numOfUpgradesGet: 0
  cooldown: 3
  skillDuration: 3
  domainPrefab: {fileID: 8066122577892052930, guid: df04f63a1809d442482117ff6dbc340b, type: 3}
  maxSize: 20
  slowDownPercentage: 0.8
  expandSpeed: 2
  damage: 5
  damageInterval: 0.5
  damageMultiplier: 2
  reducedMaxSize: 10
  increasedSkillDuration: 4
  recoverSpeedDelay: 1
  bonusDuration: 1
  shockwavePrefab: {fileID: 6733579660901800008, guid: 591a11b8c1d1140baa78a5a3c65a488e, type: 3}
  shockwaveDamage: 20
  shockwaveDamageRange: 3
  shockwaveDestoryDelay: 1
--- !u!114 &227365949848170611
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 601532811572337522}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9a7963389fc4c7d93ef5f322651f4b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SkillLifeSteal
  skillName: life steal
  skillType: 1
  description: heal yourself after the skill end. The more damage you make, the higher
    healing amount you have.
  upgrades:
  - upgradeName: Stable Gain
    description: 'Restores HP over time during the skill instead of after skill.
      (the amount is still related to damage) '
    unlocked: 0
  - upgradeName: Desperate Gambit
    description: During the skill, the lower the HP, the higher the conversion rate.
    unlocked: 0
  - upgradeName: Blood Growth
    description: If post-skill healing exceeds 20% max HP, permanently increases
      max HP
    unlocked: 0
  - upgradeName: Overflowing Aegis
    description: "During the skill, part of the player\u2019s excess healing is converted
      into a shield."
    unlocked: 0
  betterUpgrades:
  - upgradeName: Stable Gain+
    description: 'Restores HP over time during the skill instead of after skill and
      gains a shield when the skill starts. (the amount is still related to damage) '
    unlocked: 0
  - upgradeName: Desperate Gambit+
    description: "During the skill, the lower the player\u2019s health, the higher
      the conversion rate, damage, and attack speed."
    unlocked: 0
  - upgradeName: Blood Growth+
    description: If the healing amount exceeds 20% of max health, increase max health,
      armor, and attack.
    unlocked: 0
  - upgradeName: Overflowing Aegis+
    description: During the skill, part of excess healing becomes a shield. While
      the shield exists, the player gains increased damage and attack speed.
    unlocked: 0
  - upgradeName: Deathbound Bargain
    description: If the player takes fatal damage while the skill is active, they
      immediately recover to 20% max health, but lose the ability to recover health
      after the skill ends.
    unlocked: 0
  skillPhaseUpgrades:
  - upgradeName: 2 Upgrades
    description: Increase 20% of skill effect
    unlocked: 0
  - upgradeName: 4 Upgrades
    description: Using 2 times of skill will only increase 1 skill decay
    unlocked: 0
  - upgradeName: 6 Upgrades
    description: All major attribute (except skill effect) increase 10%
    unlocked: 0
  - upgradeName: Full Upgrades
    description: All major attribute (except skill effect) increase 20%
    unlocked: 0
  decreaseRate: []
  decreaseIndex: 0
  playerSkillManager: {fileID: 6596648338181236841}
  numOfUpgradesGet: 0
  cooldown: 3
  skillDuration: 3
  conversionRate: 0.3
  fireVFXPrefab: {fileID: 542231612166665799, guid: c12cd4a7ea7a9484390840497b37ed0c, type: 3}
  fireballPrefab: {fileID: 3718646501417209727, guid: 6b278988086d54af5bd66d7117ea45ea, type: 3}
  minFireballGenerationRadius: 1.5
  maxFireballGenerationRadius: 2
  fireballAmount: 5
  temporaryShield: 50
  maxConversionRate: 2
  maxDamageMultiplier: 2
  maxAttackSpeed: 2
  healingHPThreshold: 0.2
  bonusMaxHP: 10
  bonusArmor: 30
  bonusDamage: 15
  damageMultiplier: 2
  attackSpeedMultiplier: 1.5
  reviveHPMultiplier: 0.2
  amountOfBloodBack: 10
--- !u!114 &3761224169217502582
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 601532811572337522}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 586c9b935fc6a4468bbaaa505b6feff6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SkillPhase
  skillName: Phase
  skillType: 2
  description: Enter a phased state where the next attack becomes a heavy strike.
    During the phase state, the player is immune to damage and gains increased movement
    speed. If the player attacks, the phase state ends immediately. If the player
    times the phase just before an enemy attack, a perfect phase is triggered.
  upgrades:
  - upgradeName: Perfect Echo
    description: Restores a portion of HP when Perfect Phase is triggered
    unlocked: 0
  - upgradeName: Chain Strikes
    description: After triggering Perfect Phase, the next 3 attacks become heavy
      strikes
    unlocked: 0
  - upgradeName: Weakness Marking
    description: Passing through enemies during phase reduces their damage and armor
    unlocked: 0
  - upgradeName: Shadow Assassination
    description: Heavy strikes after phasing execute normal enemies below 50% health.
      If a perfect phase was triggered, the threshold increases by 10%. Deals bonus
      damage to elites and bosses.
    unlocked: 0
  betterUpgrades:
  - upgradeName: Perfect Echo+
    description: "Restore part of the player\u2019s health when the skill ends, even
      without triggering a perfect phase."
    unlocked: 0
  - upgradeName: Chain Strikes+
    description: When the skill ends, the next three attacks become heavy strikes,
      even without triggering a perfect phase.
    unlocked: 0
  - upgradeName: Weakness Marking+
    description: Passing through enemies while phased reduces their damage and armor
      and also deals damage to them.
    unlocked: 0
  - upgradeName: Shadow Assassination+
    description: Heavy strikes after phasing execute normal enemies below 75% health.
      If a perfect phase was triggered, the threshold increases by 10%. Deals increased
      damage to elites and bosses.
    unlocked: 0
  - upgradeName: Chain Phantasm
    description: Killing an enemy with a heavy strike makes the player enter a short
      phase again.
    unlocked: 0
  skillPhaseUpgrades:
  - upgradeName: 2 Upgrades
    description: Increase 20% of skill effect
    unlocked: 0
  - upgradeName: 4 Upgrades
    description: Using 2 times of skill will only increase 1 skill decay
    unlocked: 0
  - upgradeName: 6 Upgrades
    description: All major attribute (except skill effect) increase 10%
    unlocked: 0
  - upgradeName: Full Upgrades
    description: All major attribute (except skill effect) increase 20%
    unlocked: 0
  decreaseRate: []
  decreaseIndex: 0
  playerSkillManager: {fileID: 6596648338181236841}
  numOfUpgradesGet: 0
  cooldown: 3
  skillDuration: 3
  hurtCheckerPrefab: {fileID: 5438744945553926496, guid: 2ecd1dda1b74f4093bb4e3002ce09fa7, type: 3}
  damageMultiplier: 2
  speedUpPercentage: 1.5
  perfectPhaseWindow: 0.2
  lockAttackDuration: 0.5
  heavyAttackExpiryTime: 10
  heavyAttackSpeed: 15
  bonusHP: 15
  bonusNumOfHeavyAttack: 3
  phaseTrackerPrefab: {fileID: 6660558275766549021, guid: 91ac758a1168f48fbbc4f2bdde2f770c, type: 3}
  damageReduction: 10
  armorReduction: 50
  damage: 15
  bonusPhaseDuration: 1.5
