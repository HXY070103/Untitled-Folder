  m_Script: {fileID: 11500000, guid: 2f9a7963389fc4c7d93ef5f322651f4b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SkillLifeSteal
  skillName: life steal
  skillType: 1
  description: heal yourself after the skill end. The more damage you make, the higher
    healing amount you have.
  upgrades:
  - upgradeName: Unshakable Resolve
    description: If the player takes fatal damage during the skill, instantly restore
      20% max HP, but cannot heal after the skill ends
    unlocked: 0
  - upgradeName: Stable Gain
    description: Restores HP over time during the skill, but cannot heal after the
      skill ends
    unlocked: 0
  - upgradeName: Desperate Gambit
    description: Damage conversion ratio increases as HP decreases during the skill
    unlocked: 0
  - upgradeName: Blood Growth
    description: If post-skill healing exceeds 20% max HP, permanently increases
      max HP
    unlocked: 0
  - upgradeName: Blood Frenzy
    description: Increases damage taken during the skill, but also increases damage
      and attack speed
    unlocked: 0
  betterUpgrades:
  - upgradeName: Stable
    description: use 2 times of skill will increase 1 skill decay
    unlocked: 0
  - upgradeName: Blood Back
    description: if you heal enough amount of HP by this skill during skill duration,
      then this skill will not increase skill decay
    unlocked: 0
  - upgradeName: Fixed Time
    description: '(mutual exclusive with Fixed Blood)

      skill decay will not
      decrease the skill duration'
    unlocked: 0
  - upgradeName: Fixed Blood
    description: '(mutual exclusive with Fixed Time)

      skill decay will not
      decrease the ratio of healing by making damage '
    unlocked: 0
  decreaseRate: []
  decreaseIndex: 0
  playerSkillManager: {fileID: 6596648338181236841}
  cooldown: 3
  skillDuration: 3
  fireVFXPrefab: {fileID: 542231612166665799, guid: c12cd4a7ea7a9484390840497b37ed0c, type: 3}
  fireballPrefab: {fileID: 3718646501417209727, guid: 6b278988086d54af5bd66d7117ea45ea, type: 3}
  conversionRate: 0.3
  minFireballGenerationRadius: 1.5
  maxFireballGenerationRadius: 2
  fireballAmount: 5
  reviveHPMultiplier: 0.2
  maxConversionRate: 2
  healingHPThreshold: 0.2
  bonusMaxHP: 10
  damageTakenMultiplier: 2
  damageApplyMultiplier: 2
  attackAnimSpeedMultiplier: 1.5
  amountOfBloodBack: 10
--- !u!114 &3761224169217502582
MonoBehaviour:
  m_ObjectHideFlags: 0
