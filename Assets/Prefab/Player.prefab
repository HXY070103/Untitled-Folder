  m_Script: {fileID: 11500000, guid: eb984b9659922422289d138524dd1324, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SkillTimeControl
  skillName: TimeControl
  skillType: 0
  description: Creates a domain that slows down enemies and enemy projectiles within
    its area.
  upgrades:
  - upgradeName: Temporal Freeze
    description: Enemies within the field are immobilized
    unlocked: 0
  - upgradeName: Hunting Time
    description: Killing enemies during the skill extends its duration
    unlocked: 0
  - upgradeName: Synchronized Field
    description: "The field follows the player\u2019s movement"
    unlocked: 0
  - upgradeName: Temporal Corrosion
    description: Enemies within the field take continuous damage over time
    unlocked: 0
  - upgradeName: Precision Targeting
    description: The first attack against each enemy during the skill deals increased
      damage
    unlocked: 0
  betterUpgrades:
  - upgradeName: Stable
    description: use 2 times of skill will increase 1 skill decay
    unlocked: 0
  - upgradeName: Calm Fight
    description: 'if player is not injured during the skill duration, then this skill
      will not increase skill decay '
    unlocked: 0
  - upgradeName: Fixed Rate
    description: (manual exclusive with Fixed Time) skill decay will not decrease
      the rate of slow
    unlocked: 0
  - upgradeName: Fixed Time
    description: (manual exclusive with Fixed Rate) skill decay will not decrease
      the skill dutation
    unlocked: 0
  decreaseRate: []
  decreaseIndex: 0
  playerSkillManager: {fileID: 6596648338181236841}
  cooldown: 3
  skillDuration: 3
  domainPrefab: {fileID: 8066122577892052930, guid: df04f63a1809d442482117ff6dbc340b, type: 3}
  maxSize: 20
  slowDownPercentage: 0.8
  bonusDuration: 1
  damageMultiplier: 2
